# TekesQuotaKit creates only tq_ tables, so it can share your application's
# existing MySQL schema. A separate database is optional.
TEKES_QUOTA_DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/your_app?charset=utf8mb4

# Generate both secrets once with: uv run tekes-quota-kit generate-secrets
# Each must be at least 32 characters. Keep TEKES_QUOTA_TOKEN_SECRET stable
# across restarts; changing it breaks idempotent retries of every earlier request_key.
TEKES_QUOTA_ADMIN_KEY=replace-with-a-long-random-secret
TEKES_QUOTA_TOKEN_SECRET=replace-with-another-long-random-secret

# Bind address. Keep it on localhost and put a TLS reverse proxy in front.
TEKES_QUOTA_HOST=127.0.0.1
TEKES_QUOTA_PORT=9460
